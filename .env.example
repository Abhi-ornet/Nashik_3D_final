# GeoServer Configuration
# Copy this file to .env on your server or local machine:
#   cp .env.example .env

# Target GeoServer server host (e.g. http://localhost:8081 locally, or https://your-geoserver.com in prod)
VITE_GEOSERVER_TARGET_SERVER=http://localhost:8081

# Whether to use proxy (true = uses relative '/geoserver/ows', false = connects directly to VITE_GEOSERVER_TARGET_SERVER)
# Defaults to true in dev (avoids CORS) and false in production build (no proxy needed on frontend server)
VITE_USE_PROXY=false

# Optional: Override the full endpoint URL explicitly (overrides both VITE_GEOSERVER_TARGET_SERVER and VITE_USE_PROXY)
# VITE_GEOSERVER_URL=https://your-geoserver.com/geoserver/ows

# Default GeoServer workspace to load if no ?citycode= or ?workspace= URL parameter is provided (default: nashiktreecensus)
VITE_DEFAULT_WORKSPACE=nashiktreecensus

# Default GeoServer layer name to load if no ?citycode= or ?layer= URL parameter is provided (default: nashiktreecensus)
VITE_DEFAULT_LAYER_NAME=nashiktreecensus

# Geometry column name in your layer (default: geom)
VITE_GEOSERVER_GEOMETRY_COLUMN=geom

# Spatial reference system for CQL BBOX filter (default: CRS:84)
VITE_GEOSERVER_SRS=CRS:84
